PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/separated_parents
CORS_ORIGIN=*
JWT_SECRET=change-me-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=7d
OTP_SECRET=change-me-with-a-separate-random-secret-at-least-32-characters

# Email account verification: keep false until SMTP is complete and tested.
EMAIL_VERIFICATION_REQUIRED=false

# Aruba SMTP - official DueCase transactional mailbox
SMTP_HOST=smtps.aruba.it
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@duecaseununicasquadra.com
SMTP_PASS=insert-only-in-the-deployment-secret-store
EMAIL_FROM=DueCase <noreply@duecaseununicasquadra.com>

# Official DueCase contacts
SUPPORT_EMAIL=assistenza@duecaseununicasquadra.com
INFO_EMAIL=info@duecaseununicasquadra.com
PRIVACY_EMAIL=privacy@duecaseununicasquadra.com
LEGAL_EMAIL=legal@duecaseununicasquadra.com
SITE_URL=https://www.duecaseununicasquadra.com

# Enable when the corresponding public pages exist.
# PRIVACY_POLICY_URL=https://www.duecaseununicasquadra.com/privacy
# TERMS_URL=https://www.duecaseununicasquadra.com/termini
