PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/separated_parents
CORS_ORIGIN=*
JWT_SECRET=change-me-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=7d
OTP_SECRET=change-me-with-a-separate-random-secret-at-least-32-characters

# SMTP per invio OTP via email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM=DueCase <noreply@example.com>
