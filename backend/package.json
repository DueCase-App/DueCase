{
  "name": "duecase-backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/scripts/migrate.ts",
    "start": "node dist/scripts/migrate.js && node dist/server.js",
    "seed": "tsx src/scripts/seed.ts",
    "migrate:prod": "node dist/scripts/migrate.js",
    "check:public": "node --check public/professional-portal.js && node --check public/professional-password-reset.js && node --check public/account-deletion.js",
    "test": "npm run check:public && npm run build && LEGAL_GUARD_TEST_BYPASS=true node --test tests/*.test.mjs"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "expo-server-sdk": "^7.2.0",
    "fflate": "0.8.3",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "10.0.15",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
