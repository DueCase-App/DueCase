# DueCase API
#
# Production / Preview (Render):
EXPO_PUBLIC_API_URL=https://duecase-api.onrender.com/api
#
# Local development alternatives:
# iOS simulator / web:
# EXPO_PUBLIC_API_URL=http://localhost:10000/api
#
# Android emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:10000/api
#
# Physical device with Expo Go / dev client:
# use the LAN IP of the computer running the backend, for example:
# EXPO_PUBLIC_API_URL=http://192.168.1.50:10000/api
#
# Create a local .env or .env.local file and do not commit machine-specific values.
