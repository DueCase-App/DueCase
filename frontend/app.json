{
  "expo": {
    "name": "DueCase",
    "slug": "duecase",
    "owner": "tecnicoelioss-team",
    "scheme": "duecase",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-secure-store",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Consenti a DueCase di selezionare foto e ricevute da allegare ai documenti e alle spese.",
          "cameraPermission": "Consenti a DueCase di usare la fotocamera per fotografare ricevute e documenti.",
          "microphonePermission": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tecnicoelios.duecase",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tecnicoelios.duecase",
      "edgeToEdgeEnabled": true
    },
    "extra": {
      "eas": {
        "projectId": "9fb7f36d-c1ce-448b-9659-d7ea6167af1b"
      }
    }
  }
}
